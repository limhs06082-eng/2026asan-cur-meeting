rules_version = '2';

// 아산초 교육과정 연결 협의 웹앱 보안 규칙
// 원칙: 기본 거부 / 승인된 구성원만 조회 / 역할·학년·연도 권한 안에서만 쓰기 /
//       확정본 변경 금지 / 변경과 이력을 함께 저장 / 이력 수정·삭제 금지
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 최초 관리자: 운영자가 이 규칙 파일에 지정한 계정만 자기 구성원 문서를 만들 수 있다.
    //    (첫 방문자 관리자 방식이 아님. 바꾸려면 이 값을 고쳐 다시 배포한다.)
    function bootstrapEmail() { return 'limhs06082@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function wsPath(ws) { return /databases/$(database)/documents/workspaces/$(ws); }
    function memberPath(ws) { return /databases/$(database)/documents/workspaces/$(ws)/members/$(uid()); }
    function yearPath(ws, y) { return /databases/$(database)/documents/workspaces/$(ws)/years/$(y); }
    function docPath(ws, y, coll, id) { return /databases/$(database)/documents/workspaces/$(ws)/years/$(y)/$(coll)/$(id); }

    function isMember(ws) { return signedIn() && exists(memberPath(ws)) && get(memberPath(ws)).data.active == true; }
    function me(ws) { return get(memberPath(ws)).data; }
    function hasRole(ws, r) { return isMember(ws) && r in me(ws).roles; }
    function isAdmin(ws) { return hasRole(ws, 'admin'); }
    function isPlanner(ws) { return hasRole(ws, 'planner'); }

    function year(ws, y) { return get(yearPath(ws, y)).data; }
    function yearKey(ws, y) { return 'y' + string(year(ws, y).label); }
    function scope(ws, y) { return me(ws).get('scopes', {}).get(yearKey(ws, y), {}); }
    function leadGrades(ws, y) { return scope(ws, y).get('lead', []); }
    function editGrades(ws, y) { return scope(ws, y).get('edit', []).concat(leadGrades(ws, y)); }

    function isEditing(ws, y) { return exists(yearPath(ws, y)) && year(ws, y).status == 'editing'; }
    function prepAdmin(ws, y) { return isAdmin(ws) && exists(yearPath(ws, y)) && year(ws, y).status == 'preparing'; }
    // 쓰기 가능한 구성원(열람 전용이 아닌): 관리자·기획팀 또는 이 학년도 담당 학년이 있는 사람
    function isWriter(ws, y) { return isMember(ws) && (isAdmin(ws) || isPlanner(ws) || editGrades(ws, y).size() > 0); }

    // 카드 학년 편집 권한. 0 = 학교 공통 카드(기획팀·관리자 관리)
    function canEditGrade(ws, y, g) {
      return isMember(ws) && (isAdmin(ws) || (g == 0 && isPlanner(ws)) || (g > 0 && g in editGrades(ws, y)));
    }
    function isLead(ws, y, g) {
      return isMember(ws) && ((g > 0 && g in leadGrades(ws, y)) || (g == 0 && (isPlanner(ws) || isAdmin(ws))));
    }

    function nowStamped(d) { return d.updatedAt == request.time && d.updatedBy == uid(); }

    // 이 문서 쓰기와 같은 요청 안에서 이력(event)이 함께 저장되는지 확인
    function pairedEvent(ws, y, coll, id) {
      let opId = request.resource.data.lastOpId;
      let ev = getAfter(docPath(ws, y, 'events', opId));
      return opId is string && existsAfter(docPath(ws, y, 'events', opId))
        && ev.data.targetColl == coll && ev.data.targetId == id && ev.data.actorUid == uid();
    }

    function str(v, max) { return v is string && v.size() <= max; }
    function strReq(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    // ───────────── 작업 공간 ─────────────
    match /workspaces/{ws} {
      allow read: if isMember(ws);
      allow create: if signedIn() && request.auth.token.email == bootstrapEmail() && request.auth.token.email_verified == true;
      allow update: if isAdmin(ws);
      allow delete: if false;

      // 구성원: 권한 필드는 관리자만 변경. 본인은 자기 문서를 읽을 수 있다.
      match /members/{memberId} {
        allow read: if signedIn() && (memberId == uid() || isAdmin(ws));
        allow create, update: if isAdmin(ws)
          || (signedIn() && memberId == uid()
              && request.auth.token.email == bootstrapEmail() && request.auth.token.email_verified == true
              && request.resource.data.roles == ['admin'] && request.resource.data.active == true);
        allow delete: if false;
      }

      // 접근 요청: 로그인한 사람이 자기 요청만 남긴다. 요청만으로는 아무 자료도 볼 수 없다.
      match /accessRequests/{reqId} {
        allow read: if signedIn() && (reqId == uid() || isAdmin(ws));
        allow create, update: if signedIn() && reqId == uid()
          && request.resource.data.uid == uid()
          && request.resource.data.email == request.auth.token.email
          && str(request.resource.data.note, 300) && str(request.resource.data.displayName, 100)
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'note', 'createdAt']);
        allow delete: if isAdmin(ws);
      }

      match /sources/{sourceId} {
        allow read: if isMember(ws);
        allow create, update: if isAdmin(ws);
        allow delete: if false;
      }

      match /jobs/{jobId} {
        allow read: if isMember(ws);
        allow create, update: if isAdmin(ws);
        allow delete: if false;
      }

      // ───────────── 작업본(연도·수정본) ─────────────
      match /years/{y} {
        allow read: if isMember(ws);
        allow create: if isAdmin(ws) && request.resource.data.status == 'preparing';
        // 상태 전환: 준비 중 → 편집 중 → 확정본. 확정본은 관리자도 수정 불가.
        allow update: if isAdmin(ws) && resource.data.status != 'final'
          && (request.resource.data.status == resource.data.status
              || (resource.data.status == 'preparing' && request.resource.data.status == 'editing')
              || (resource.data.status == 'editing' && request.resource.data.status == 'final'))
          && request.resource.data.label == resource.data.label;
        allow delete: if false;

        // 이력: 생성만 가능. 행위자·서버 시각 검증. 대상 문서가 같은 요청에서 이 operationId로 바뀌어야 한다.
        match /events/{opId} {
          allow read: if isMember(ws);
          allow create: if prepAdmin(ws, y) || (
            isWriter(ws, y)
            && (isEditing(ws, y) || (request.resource.data.targetColl == 'meta' && isAdmin(ws)))
            && request.resource.data.operationId == opId
            && request.resource.data.actorUid == uid()
            && request.resource.data.at == request.time
            && request.resource.data.op is string
            && (request.resource.data.targetColl == 'meta'
                ? (isAdmin(ws) && getAfter(yearPath(ws, y)).data.lastOpId == opId)
                : getAfter(docPath(ws, y, request.resource.data.targetColl, request.resource.data.targetId)).data.lastOpId == opId)
          );
          allow update, delete: if false;
        }

        // ── 카드
        function validCard(d) {
          return d.keys().hasAll(['grade', 'title', 'learningPurpose', 'primaryCategory', 'categories', 'focusTags', 'topics', 'contentVersion', 'deletedAt', 'checkFlags'])
            && d.grade is int && d.grade >= 0 && d.grade <= 6
            && strReq(d.title, 120)
            && str(d.learningPurpose, 1000)
            && strReq(d.primaryCategory, 40)
            && d.categories is list && d.categories.size() <= 10
            && d.focusTags is list && d.focusTags.size() <= 3 && d.focusTags.toSet().difference(['배움', '자람', '나눔'].toSet()).size() == 0
            && d.topics is list && d.topics.size() <= 12
            && d.checkFlags is list && d.checkFlags.size() <= 10
            && (d.changeType == null || d.changeType in ['keep', 'modify', 'add', 'end'])
            && str(d.changeReason, 1000) && str(d.addReason, 1000)
            && d.contentVersion is int
            && (d.deletedAt == null || d.deletedAt == request.time || (resource != null && d.deletedAt == resource.data.deletedAt));
        }
        // 일반 수정에서 바꿀 수 없는 필드: 원문 출처·원본 ID·출생 정보
        function protectedCardFieldsUnchanged() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['origin', 'originCardId', 'originYearId', 'grade']);
        }
        match /cards/{cardId} {
          allow read: if isMember(ws);
          allow create: if prepAdmin(ws, y) || (
            isEditing(ws, y) && validCard(request.resource.data)
            && (canEditGrade(ws, y, request.resource.data.grade)
                || (isPlanner(ws) && request.resource.data.origin == 'common-split'))
            && request.resource.data.contentVersion == 1
            && request.resource.data.deletedAt == null
            && request.resource.data.origin in ['teacher', 'common-split']
            && request.resource.data.sourceOccurrences.size() <= 30
            && nowStamped(request.resource.data)
            && pairedEvent(ws, y, 'cards', cardId)
          );
          allow update: if prepAdmin(ws, y) || (
            isEditing(ws, y) && validCard(request.resource.data)
            && canEditGrade(ws, y, resource.data.grade)
            && request.resource.data.contentVersion == resource.data.contentVersion + 1
            && (protectedCardFieldsUnchanged()
                || (isAdmin(ws) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['origin', 'originCardId', 'originYearId'])))
            && (request.resource.data.sourceOccurrences == resource.data.sourceOccurrences
                || request.resource.data.sourceOccurrences.size() > resource.data.sourceOccurrences.size())
            && nowStamped(request.resource.data)
            && pairedEvent(ws, y, 'cards', cardId)
          );
          allow delete: if false;
        }

        // ── 학년 사실 확인: 해당 학년 편집자, 현재 카드 버전, 배움의 목적 필수
        match /cardChecks/{cardId} {
          allow read: if isMember(ws);
          allow create, update: if prepAdmin(ws, y) || (
            isEditing(ws, y)
            && request.resource.data.cardId == cardId
            && request.resource.data.uid == uid()
            && request.resource.data.at == request.time
            && (request.resource.data.revokedAt == null || request.resource.data.revokedAt == request.time)
            && request.resource.data.grade == get(docPath(ws, y, 'cards', cardId)).data.grade
            && canEditGrade(ws, y, request.resource.data.grade)
            && (request.resource.data.revokedAt != null || (
                 request.resource.data.contentVersion == get(docPath(ws, y, 'cards', cardId)).data.contentVersion
                 && get(docPath(ws, y, 'cards', cardId)).data.deletedAt == null
                 && get(docPath(ws, y, 'cards', cardId)).data.learningPurpose.size() > 0))
            && pairedEvent(ws, y, 'cardChecks', cardId)
          );
          allow delete: if false;
        }

        // ── 학년 정비 완료: 해당 학년 대표만
        match /gradeReviews/{gid} {
          allow read: if isMember(ws);
          allow create, update: if prepAdmin(ws, y) || (
            isEditing(ws, y)
            && request.resource.data.grade is int
            && gid == 'g' + string(request.resource.data.grade)
            && isLead(ws, y, request.resource.data.grade)
            && request.resource.data.grade > 0
            && request.resource.data.uid == uid()
            && request.resource.data.at == request.time
            && request.resource.data.cardVersions is map
            && pairedEvent(ws, y, 'gradeReviews', gid)
          );
          allow delete: if false;
        }

        // ── 연결
        function validConnection(d, connId) {
          return d.type in ['deepen', 'joint', 'common']
            && d.fromCardId is string && d.toCardId is string && d.fromCardId != d.toCardId
            && connId == d.type + '__' + d.fromCardId + '__' + d.toCardId
            && (d.type == 'deepen' || d.fromCardId < d.toCardId)
            && strReq(d.reason, 2000)
            && str(d.topicId, 40)
            && (d.type != 'deepen' || (strReq(d.inheritedLearning, 2000) && strReq(d.deepenedLearning, 2000) && str(d.skipReason, 1000)))
            && (d.type != 'joint' || (d.rolesByGrade is map && d.rolesByGrade.keys().hasAll(['g' + string(d.fromGrade), 'g' + string(d.toGrade)]) && strReq(d.sharedResult, 2000)))
            && (d.type != 'common' || (strReq(d.commonGoal, 2000) && strReq(d.gradeScope, 2000)))
            && d.version is int;
        }
        function cardOf(ws, y, id) { return get(docPath(ws, y, 'cards', id)).data; }
        match /connections/{connId} {
          allow read: if isMember(ws);
          allow create: if prepAdmin(ws, y) || (
            isEditing(ws, y) && isWriter(ws, y)
            && validConnection(request.resource.data, connId)
            && request.resource.data.version == 1
            && request.resource.data.deletedAt == null
            && cardOf(ws, y, request.resource.data.fromCardId).deletedAt == null
            && cardOf(ws, y, request.resource.data.toCardId).deletedAt == null
            && cardOf(ws, y, request.resource.data.fromCardId).grade == request.resource.data.fromGrade
            && cardOf(ws, y, request.resource.data.toCardId).grade == request.resource.data.toGrade
            && (request.resource.data.type != 'deepen'
                || request.resource.data.toGrade - request.resource.data.fromGrade <= 1
                && request.resource.data.fromGrade - request.resource.data.toGrade <= 1
                || request.resource.data.fromGrade == 0 || request.resource.data.toGrade == 0
                || request.resource.data.skipReason.size() > 0)
            && request.resource.data.createdBy == uid()
            && nowStamped(request.resource.data)
            && pairedEvent(ws, y, 'connections', connId)
          );
          // 종류·끝점은 ID에 포함되어 바꿀 수 없다(바꾸려면 새 연결). 내용 변경 시 버전 증가 → 기존 확인 무효.
          allow update: if prepAdmin(ws, y) || (
            isEditing(ws, y) && isWriter(ws, y)
            && (isAdmin(ws) || isPlanner(ws) || resource.data.createdBy == uid()
                || resource.data.fromGrade in editGrades(ws, y) || resource.data.toGrade in editGrades(ws, y))
            && validConnection(request.resource.data, connId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type', 'fromCardId', 'toCardId', 'fromGrade', 'toGrade', 'createdBy', 'originConnectionId', 'originAgreement'])
            && request.resource.data.version == resource.data.version + 1
            && (request.resource.data.deletedAt == null
                ? (cardOf(ws, y, resource.data.fromCardId).deletedAt == null && cardOf(ws, y, resource.data.toCardId).deletedAt == null)
                : (request.resource.data.deletedAt == request.time || request.resource.data.deletedAt == resource.data.deletedAt))
            && nowStamped(request.resource.data)
            && pairedEvent(ws, y, 'connections', connId)
          );
          allow delete: if false;
        }

        // ── 연결 확인(승인): 관련 학년의 대표만, 현재 연결·카드 버전과 일치할 때만
        match /approvals/{aid} {
          allow read: if isMember(ws);
          allow create, update: if prepAdmin(ws, y) || (
            isEditing(ws, y)
            && aid == request.resource.data.connectionId + '__g' + string(request.resource.data.grade)
            && isLead(ws, y, request.resource.data.grade)
            && request.resource.data.uid == uid()
            && request.resource.data.at == request.time
            && (request.resource.data.grade == get(docPath(ws, y, 'connections', request.resource.data.connectionId)).data.fromGrade
                || request.resource.data.grade == get(docPath(ws, y, 'connections', request.resource.data.connectionId)).data.toGrade)
            && (request.resource.data.revokedAt == request.time || (
                 request.resource.data.revokedAt == null
                 && get(docPath(ws, y, 'connections', request.resource.data.connectionId)).data.deletedAt == null
                 && request.resource.data.connectionVersion == get(docPath(ws, y, 'connections', request.resource.data.connectionId)).data.version
                 && request.resource.data.fromCardId == get(docPath(ws, y, 'connections', request.resource.data.connectionId)).data.fromCardId
                 && request.resource.data.toCardId == get(docPath(ws, y, 'connections', request.resource.data.connectionId)).data.toCardId
                 && request.resource.data.fromVersion == cardOf(ws, y, request.resource.data.fromCardId).contentVersion
                 && request.resource.data.toVersion == cardOf(ws, y, request.resource.data.toCardId).contentVersion
                 && cardOf(ws, y, request.resource.data.fromCardId).deletedAt == null
                 && cardOf(ws, y, request.resource.data.toCardId).deletedAt == null))
            && pairedEvent(ws, y, 'approvals', aid)
          );
          allow delete: if false;
        }

        // ── 주제별 독립 운영·추가 확인 판단. 확인(confirm)은 해당 학년 대표만.
        match /reviews/{rid} {
          allow read: if isMember(ws);
          allow create, update: if prepAdmin(ws, y) || (
            isEditing(ws, y)
            && request.resource.data.decision in ['independent', 'needsCheck']
            && str(request.resource.data.reason, 2000)
            && request.resource.data.grade == cardOf(ws, y, request.resource.data.cardId).grade
            && (
              // 판단 내용 작성·수정(학년 편집자): 버전 증가, 확인 필드는 그대로
              (canEditGrade(ws, y, request.resource.data.grade)
                && request.resource.data.version == (resource == null ? 1 : resource.data.version + 1)
                && request.resource.data.reason.size() > 0
                && (resource == null ? request.resource.data.confirm == null : request.resource.data.confirm == resource.data.confirm)
                && nowStamped(request.resource.data))
              ||
              // 확인/확인 해제(학년 대표): 내용은 그대로, 확인 필드만
              (resource != null && isLead(ws, y, request.resource.data.grade)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirm', 'lastOpId'])
                && (request.resource.data.confirm == null
                    || (request.resource.data.confirm.uid == uid() && request.resource.data.confirm.at == request.time
                        && request.resource.data.confirm.reviewVersion == resource.data.version
                        && request.resource.data.confirm.cardVersion == cardOf(ws, y, resource.data.cardId).contentVersion)))
            )
            && pairedEvent(ws, y, 'reviews', rid)
          );
          allow delete: if false;
        }

        // ── 제안: 제출만으로 카드는 바뀌지 않는다(별도 문서).
        match /proposals/{pid} {
          allow read: if isMember(ws);
          allow create: if prepAdmin(ws, y) || (
            isEditing(ws, y) && isWriter(ws, y)
            && request.resource.data.status == 'discussing'
            && request.resource.data.kind in ['add', 'modify', 'merge', 'independent', 'end', 'other']
            && strReq(request.resource.data.title, 200) && strReq(request.resource.data.content, 3000) && str(request.resource.data.reason, 2000)
            && request.resource.data.createdBy == uid()
            && request.resource.data.version == 1
            && pairedEvent(ws, y, 'proposals', pid)
          );
          allow update: if prepAdmin(ws, y) || (
            isEditing(ws, y) && isWriter(ws, y)
            && (isAdmin(ws) || isPlanner(ws) || resource.data.createdBy == uid() || resource.data.grade in editGrades(ws, y))
            && request.resource.data.status in ['discussing', 'accepted', 'held', 'rejected']
            && request.resource.data.version == resource.data.version + 1
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'targetType', 'targetId', 'targetVersion'])
            && request.resource.data.updatedBy == uid()
            && (request.resource.data.status == 'discussing' || request.resource.data.decisionReason.size() > 0)
            && pairedEvent(ws, y, 'proposals', pid)
          );
          allow delete: if false;
        }

        // ── 의견: 작성만 가능(본문 변경과 분리). 확정본에는 추가 불가.
        match /discussions/{did} {
          allow read: if isMember(ws);
          allow create: if prepAdmin(ws, y) || (
            isEditing(ws, y) && isWriter(ws, y)
            && request.resource.data.authorUid == uid()
            && request.resource.data.createdAt == request.time
            && strReq(request.resource.data.text, 2000)
            && request.resource.data.targetType in ['card', 'connection', 'proposal']
          );
          allow update, delete: if false;
        }

        // ── 중복 후보를 '별도 활동'으로 확인한 기록
        match /dupDecisions/{pid} {
          allow read: if isMember(ws);
          allow create, update: if prepAdmin(ws, y) || (
            isEditing(ws, y) && canEditGrade(ws, y, request.resource.data.grade)
            && cardOf(ws, y, request.resource.data.cardA).grade == request.resource.data.grade
            && cardOf(ws, y, request.resource.data.cardB).grade == request.resource.data.grade
            && pid == request.resource.data.cardA + '__' + request.resource.data.cardB
            && request.resource.data.uid == uid() && request.resource.data.at == request.time
            && strReq(request.resource.data.reason, 1000)
          );
          allow delete: if false;
        }
      }
    }
  }
}
